<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_preview_bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Сегодня"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/widget_preview_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹   ›"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/widget_preview_text_secondary" />
    </LinearLayout>

    <!-- Lesson 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_preview_card_bg"
        android:padding="12dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="08:30 — 10:00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_preview_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="каб. 302"
                android:textSize="12sp"
                android:textColor="@color/widget_preview_text_secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Высшая математика"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_preview_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Иванов И. И."
            android:textSize="12sp"
            android:textColor="@color/widget_preview_text_secondary" />
    </LinearLayout>

    <!-- Lesson 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_preview_card_bg"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="10:15 — 11:45"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_preview_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="каб. 415"
                android:textSize="12sp"
                android:textColor="@color/widget_preview_text_secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Информатика и ИКТ"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_preview_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Петров П. П."
            android:textSize="12sp"
            android:textColor="@color/widget_preview_text_secondary" />
    </LinearLayout>

</LinearLayout>

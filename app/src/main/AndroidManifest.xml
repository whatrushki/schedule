<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".ScheduleApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WHATSchedule">

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".ScheduleActivity"
            android:exported="true"
            android:enabled="true"
            android:theme="@style/Theme.WHATSchedule" />

        <!-- Основной / Тёмный алиас (дефолтная иконка) -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".ScheduleActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Светлый алиас -->
        <activity-alias
            android:name=".MainActivityLight"
            android:targetActivity=".ScheduleActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Terracotta (Оранжевая) -->
        <activity-alias
            android:name=".MainActivityTerracottaDark"
            android:targetActivity=".ScheduleActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_terracotta"
            android:roundIcon="@mipmap/ic_launcher_terracotta_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityTerracottaLight"
            android:targetActivity=".ScheduleActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_terracotta_light"
            android:roundIcon="@mipmap/ic_launcher_terracotta_light_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Crimson (Красная) -->
        <activity-alias
            android:name=".MainActivityCrimsonDark"
            android:targetActivity=".ScheduleActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_crimson"
            android:roundIcon="@mipmap/ic_launcher_crimson_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityCrimsonLight"
            android:targetActivity=".ScheduleActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_crimson_light"
            android:roundIcon="@mipmap/ic_launcher_crimson_light_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Forest (Зелёная) -->
        <activity-alias
            android:name=".MainActivityForestDark"
            android:targetActivity=".ScheduleActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_forest"
            android:roundIcon="@mipmap/ic_launcher_forest_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityForestLight"
            android:targetActivity=".ScheduleActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_forest_light"
            android:roundIcon="@mipmap/ic_launcher_forest_light_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Plum (Фиолетовая) -->
        <activity-alias
            android:name=".MainActivityPlumDark"
            android:targetActivity=".ScheduleActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_plum"
            android:roundIcon="@mipmap/ic_launcher_plum_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityPlumLight"
            android:targetActivity=".ScheduleActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_plum_light"
            android:roundIcon="@mipmap/ic_launcher_plum_light_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>


        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:theme="@style/Theme.WHATSchedule" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.what.schedule.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".features.widget.ScheduleWidgetConfigurationActivity"
            android:exported="true"
            android:theme="@style/Theme.WHATSchedule">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".features.widget.ScheduleWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".notifications.FirstLessonAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.what.schedule.FIRST_LESSON_ALARM" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
{
  "name": "what-schedule-bot",
  "version": "1.0.0",
  "description": "WHAT Schedule Telegram Bot - Edge Worker on Cloudflare",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute what-schedule-bot-db --local --file=./schema.sql",
    "d1:init:prod": "wrangler d1 execute what-schedule-bot-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.151.3"
  }
}
